// Teste de manipulação de arrays (vetores), chamadas de sub-rotinas e booleanos
class TesteVetor {
    function void main() {
        var Array lista;
        var int i, tamanho, soma;
        var boolean ativo;

        let tamanho = 5;
        let lista = Array.new(tamanho);
        let i = 0;
        let soma = 0;
        let ativo = true;

        while ((i < tamanho) & ativo) {
            let lista[i] = i * 2;
            let soma = soma + lista[i];
            let i = i + 1;
        }

        if (soma > 10) {
            do Output.printString("Soma maior que 10");
            do Output.println();
        } else {
            let ativo = false;
        }

        do lista.dispose();
        let lista = null;
        return;
    }
}

