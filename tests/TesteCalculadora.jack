// Teste de construtor, métodos, parâmetros, while, if-else e operadores unários/binários
class Calculadora {
    static int totalOperacoes;
    field int memoria;

    constructor Calculadora new(int valorInicial) {
        let memoria = valorInicial;
        let totalOperacoes = 0;
        return this;
    }

    method int calcular(int a, int b) {
        var int resultado, contador;
        let resultado = (a * b) - (-a);
        let contador = 0;

        while (contador < b) {
            if (~(resultado = 0)) {
                let resultado = resultado + a;
            } else {
                let resultado = 1;
            }
            let contador = contador + 1;
        }

        let memoria = resultado;
        let totalOperacoes = totalOperacoes + 1;
        do Output.printInt(resultado);
        return resultado;
    }
}

